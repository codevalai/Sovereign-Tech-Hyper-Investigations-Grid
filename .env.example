# Server listening port (defaults to 3000)
PORT="3000"

# Public URL where the service is hosted (optional)
APP_URL="http://localhost:3000"

# TLSN_VERIFIER_URL (Optional): Local TLSNotary Proxy-Mode prover/verifier sidecar URL
# (e.g., http://127.0.0.1:7047). When unset or offline, the grid fails closed cleanly with
# ZKTLS_PROVENANCE_STATUS="LOCAL_HASH_ONLY (TLSN_SIDECAR_OFFLINE)" and never fabricates proofs.
TLSN_VERIFIER_URL=""

# GEMINI_API_KEY (Optional / Not Required for zero-key live OSINT probes)
GEMINI_API_KEY=""
