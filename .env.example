# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TLSN_VERIFIER_URL (Optional): Local TLSNotary Proxy-Mode prover/verifier sidecar URL
# (e.g., http://127.0.0.1:7047). When unset or offline, the grid fails closed cleanly with
# ZKTLS_PROVENANCE_STATUS="LOCAL_HASH_ONLY (TLSN_SIDECAR_OFFLINE)" and never fakes proofs.
TLSN_VERIFIER_URL=""

# OPENFEC_API_KEY (Optional): Free public api.data.gov key for higher rate limits on
# OpenFEC (PACs, Schedule A/B/E) and Regulations.gov v4 corporate comment letters.
# When unset, OpenFEC automatically falls back to public DEMO_KEY.
OPENFEC_API_KEY=""

# COURTLISTENER_API_TOKEN (Optional): Free CourtListener REST v4 API token for authenticated
# RECAP federal dockets (type=r) and judicial opinions (type=o) without anonymous limits.
COURTLISTENER_API_TOKEN=""

# COMPANIES_HOUSE_API_KEY (Optional): Free UK Companies House REST API key (HTTP Basic Auth)
# for UK subsidiary search, corporate officers/directors, and PSC/UBO unmasking.
COMPANIES_HOUSE_API_KEY=""

# LDA_API_KEY (Optional): Free US Senate Lobbying Disclosure Act API token for unthrottled
# LD-1/LD-2/LD-203 filings, revolving-door covered_position, bills, and quarterly spend.
LDA_API_KEY=""

# GITHUB_TOKEN (Optional): GitHub personal access token for 5,000 req/hr org & repo intel.
GITHUB_TOKEN=""

# NVD_API_KEY (Optional): Free NIST NVD CVE 2.0 API key for 50 req/30s vulnerability audits.
NVD_API_KEY=""

# VT_API_KEY (Optional): VirusTotal v3 API key for domain reputation, engine verdicts & DNS intel.
VT_API_KEY=""

# OTX_API_KEY (Optional): AlienVault OTX API key for domain threat pulses & malware/C2 indicators.
OTX_API_KEY=""

# EXODUS_API_TOKEN (Optional): Exodus Privacy API token for Android app surveillance/ad tracker reports
# (Squad U). When unset, gracefully falls back to public Exodus Privacy search index.
EXODUS_API_TOKEN=""

# ETHERSCAN_API_KEY (Optional): Etherscan API V2 key for verified EVM Solidity source, ABI,
# and normal/ERC-20 transfer history (Squad O). Falls back to Sourcify v2 + PublicNode when unset.
ETHERSCAN_API_KEY=""

# ALCHEMY_ETH_RPC_URL (Optional): Full HTTPS Alchemy Ethereum mainnet JSON-RPC URL for
# eth_getBalance, eth_getCode, alchemy_getTokenBalances & alchemy_getAssetTransfers (Squad O).
# Falls back to https://ethereum-rpc.publicnode.com when unset. Never logged or exposed.
ALCHEMY_ETH_RPC_URL=""

# ALCHEMY_SOL_RPC_URL (Optional): Full HTTPS Alchemy Solana mainnet JSON-RPC URL for
# getBalance, getAccountInfo, getTokenLargestAccounts & getSignaturesForAddress (Squad O).
# Falls back to https://api.mainnet-beta.solana.com when unset. Never logged or exposed.
ALCHEMY_SOL_RPC_URL=""
